load("@prelude//:rules.bzl", "filegroup")
load(":defs.bzl", "tidepool_execution_platforms")

tidepool_execution_platforms(
    name = "platforms",
    host_platform = "prelude//platforms:default",
    remote = read_root_config("remote", "enabled", "false") == "true",
    toolchain = read_root_config("remote", "toolchain", ""),
)

filegroup(
    name = "qualification_inputs",
    srcs = {"platforms/" + source: source for source in glob(["BUCK", "*.bzl"])},
    visibility = ["PUBLIC"],
)
