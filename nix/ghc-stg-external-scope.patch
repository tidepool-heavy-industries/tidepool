+
+-- Omitted definitions retain their exact original arity and demand metadata
+-- even when occurrences were decoded without interface pragmas.
+initEnvWithExternalScope :: Bool -> [(Id, TagSig)] -> TagEnv 'CodeGen
+initEnvWithExternalScope for_bytecode sigs =
+    (extendSigEnv (initEnv for_bytecode) sigs)
+        { te_external = if for_bytecode then emptyVarEnv
+                        else mkVarEnv [(v, v) | (v, _) <- sigs] }
+
+lookupExternalId :: TagEnv p -> Id -> Maybe Id
+lookupExternalId env fun = lookupVarEnv (te_external env) fun

