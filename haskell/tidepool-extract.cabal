cabal-version: 2.4
name:          tidepool-extract
version:       0.1.0.0
build-type:    Simple
extra-source-files:
  lib/Tidepool/Double.hs
  test-prepared-stg/site-fixtures/*.hs
  test-prepared-stg/RepPoly.hs
  test-prepared-stg/RepPolyImport.hs

-- Internal (unexposed) sub-library: the genuinely shared extractor
-- implementation, compiled ONCE per configuration instead of once per
-- component. Chosen over a plain top-level `library` stanza because this
-- package has no public API of its own (it's an app, not a library people
-- depend on) — an internal library says "shared build unit" without implying
-- a package-level export surface. tidepool-extract-bin and the three
-- src/-dependent test-suites below all depend on it.
library tidepool-extract-internal
  hs-source-dirs:   src
  exposed-modules:
    Tidepool.Binders
    Tidepool.CborEncode
    Tidepool.DependencyEvidence
    Tidepool.WorkerServer
    Tidepool.DiagJson
    Tidepool.EffectSchema
    Tidepool.ExtractUtil
    Tidepool.ExtractRequest
    Tidepool.FatIface
    Tidepool.GhcPipeline
    Tidepool.Identity
    Tidepool.Introspection
    Tidepool.Metadata
    Tidepool.PrimOps
    Tidepool.PreparedStg
    Tidepool.PreparedRecovery
    Tidepool.PreparedBuiltins
    Tidepool.PreparedFacts
    Tidepool.PreparedFormatting
    Tidepool.PreparedTime
    Tidepool.PreparedJson
    Tidepool.SiteClassifier
    Tidepool.PreparedSites
    Tidepool.RetainedUnfoldings
    Tidepool.ExecutionIR
    Tidepool.ExecutionSchema
    Tidepool.ExecutionProjection
    Tidepool.ExecutionEncode
    Tidepool.Json
    Tidepool.Resolve
    Tidepool.Session
    Tidepool.SessionArtifacts
    Tidepool.Timing
    Tidepool.TypePolicy
    Tidepool.TurnSource
  build-depends:
    base         >= 4.20 && < 5,
    ghc          >= 9.12 && < 9.13,
    ghc-boot     >= 9.12 && < 9.13,
    bytestring,
    containers,
    filepath,
    directory,
    process,
    template-haskell,
    text,
    cborg,
    cryptohash-sha256,
    mtl,
    syb,
    lens,
    errors,
    witherable,
    safe
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall

test-suite cell-splitter-test
  type:             exitcode-stdio-1.0
  main-is:          CellSplitterTest.hs
  hs-source-dirs:   test-cell-splitter
  build-depends:
    base >= 4.20 && < 5,
    ghc >= 9.12 && < 9.13,
    directory,
    filepath,
    tidepool-extract-internal
  default-language: GHC2024
  ghc-options:      -Wall

test-suite display-tree-test
  type:             exitcode-stdio-1.0
  main-is:          DisplayTreeTest.hs
  hs-source-dirs:   lib test-display-tree
  other-modules:    Tidepool.Inspection.Tree
  build-depends:
    base >= 4.20 && < 5,
    text
  default-language: GHC2024
  ghc-options:      -Wall

test-suite introspection-search-test
  type:             exitcode-stdio-1.0
  main-is:          IntrospectionSearchTest.hs
  hs-source-dirs:   test
  build-depends:
    base >= 4.20 && < 5,
    ghc >= 9.12 && < 9.13,
    tidepool-extract-internal,
    directory,
    filepath,
    process
  default-language: GHC2024
  ghc-options:      -Wall

-- The only default-built executable. `app/Main.hs`'s own import closure pulls
-- in no lib/Tidepool/** module (the eval stdlib is a runtime GHC include
-- path, not a host-compiled dependency — see haskell/CLAUDE.md), so
-- hs-source-dirs is just `app` and everything else comes from the internal
-- library.
executable tidepool-extract-bin
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    base >= 4.20 && < 5,
    ghc  >= 9.12 && < 9.13,
    tidepool-extract-internal,
    bytestring,
    containers,
    filepath,
    directory,
    text
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall

test-suite execution-inventory
  type:             exitcode-stdio-1.0
  main-is:          ExecutionInventoryTest.hs
  hs-source-dirs:   test-execution-inventory
  build-depends:
    base >= 4.20 && < 5,
    containers,
    tidepool-extract-internal
  default-language: GHC2024
  ghc-options:      -Wall

test-suite execution-schema-encode
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test-execution-schema-encode
  build-depends:
    base >= 4.20 && < 5,
    bytestring,
    cborg,
    tidepool-extract-internal
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall

test-suite execution-schema-projection
  type:             exitcode-stdio-1.0
  main-is:          ExecutionProjectionProbe.hs
  hs-source-dirs:   test-prepared-stg
  other-modules:
    CallerResultProjectionTest
    DeferredFunctionProjectionTest
    ExecutionProjectionTest
  build-depends:
    base >= 4.20 && < 5,
    bytestring,
    containers,
    directory,
    filepath,
    ghc >= 9.12 && < 9.13,
    process,
    text,
    tidepool-extract-internal
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall

test-suite execution-corpus-projection
  type:             exitcode-stdio-1.0
  main-is:          ExecutionCorpusProbe.hs
  hs-source-dirs:   test-execution-corpus
  other-modules:    ExecutionCorpusInventory
  build-depends:
    base >= 4.20 && < 5,
    bytestring,
    containers,
    directory,
    filepath,
    ghc >= 9.12 && < 9.13,
    text,
    tidepool-extract-internal
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall

test-suite prepared-stg-pipeline-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test-prepared-stg
  other-modules:
    RetainedPluginTest
    TypeEvidenceChecks
  build-depends:
    base         >= 4.20 && < 5,
    ghc          >= 9.12 && < 9.13,
    containers,
    mtl,
    text,
    tidepool-extract-internal,
    directory,
    filepath
  default-language: GHC2024
  default-extensions: OverloadedStrings

-- Property coverage for "Tidepool.Swarm"'s 'Cycles' budget currency
-- (operator's type-level review, 2026-08-17): the conservation law
-- 'splitAllowance' is supposed to hold by construction, checked against many
-- random inputs rather than one pinned scenario. Deliberately independent of
-- tidepool-extract-internal — this is plain-GHC business logic, not the
-- extractor pipeline, so it costs no extract compile. QuickCheck itself is
-- not in the nix with-packages GHC env and resolves from Hackage at the
-- project's pinned index-state (cabal.project's index-state) — the same
-- pattern cborg/half already use (see haskell/CLAUDE.md's toolchain
-- section); cabal.project.freeze grows the matching constraint entries the
-- first time this stanza is built.
-- Run: cabal test swarm-spec-test  (needs the nix with-packages GHC on PATH).
test-suite swarm-spec-test
  type:             exitcode-stdio-1.0
  main-is:          SwarmSpecTest.hs
  hs-source-dirs:   lib, test-swarm
  other-modules:
    Tidepool.Swarm
    SwarmSpec
  build-depends:
    base       >= 4.20 && < 5,
    QuickCheck >= 2.14 && < 2.16
  default-language: GHC2024
  default-extensions:
    OverloadedStrings
    DeriveFunctor
    DeriveFoldable
    DeriveTraversable
  ghc-options:      -Wall

-- Unit coverage for 'Tidepool.Aeson.Value.eitherDecodeValue''s hand-written
-- RFC 8259 parser used by prepared-STG answer decoding. Plain-GHC business
-- logic, so — like swarm-spec-test — this reaches `lib` directly
-- and costs no extract compile.
-- Run: cabal test aeson-value-spec-test  (needs the nix with-packages GHC on PATH).
test-suite aeson-value-spec-test
  type:             exitcode-stdio-1.0
  main-is:          AesonValueSpecTest.hs
  hs-source-dirs:   lib, test-aeson
  other-modules:
    Tidepool.Aeson.Value
    Tidepool.Aeson.Scientific
    Tidepool.Data.Text
    Tidepool.Double
  build-depends:
    base       >= 4.20 && < 5,
    containers,
    text
  default-language: GHC2024
  default-extensions:
    OverloadedStrings
  ghc-options:      -Wall

test-suite fat-iface-exact-test
  type:             exitcode-stdio-1.0
  main-is:          FatIfaceExactTest.hs
  hs-source-dirs:   test-prepared-stg
  build-depends:
    base         >= 4.20 && < 5,
    directory,
    filepath,
    process,
    ghc          >= 9.12 && < 9.13,
    tidepool-extract-internal
  default-language: GHC2024
  ghc-options:      -Wall

-- Wave-5 B2: recover one real package body from an -O0 caller, prepare it in
-- its defining interface context, and project it together with the caller.
test-suite recovered-body-test
  type:             exitcode-stdio-1.0
  main-is:          RecoveredBodyTest.hs
  hs-source-dirs:   test-prepared-stg
  build-depends:
    base >= 4.20 && < 5,
    directory,
    filepath,
    process,
    text,
    ghc >= 9.12 && < 9.13,
    tidepool-extract-internal
  default-language: GHC2024
  ghc-options:      -Wall

test-suite prepared-recovery-test
  type:             exitcode-stdio-1.0
  main-is:          PreparedRecoveryTest.hs
  hs-source-dirs:   test-prepared-stg
  build-depends:
    base >= 4.20 && < 5,
    directory,
    filepath,
    process,
    text,
    ghc >= 9.12 && < 9.13,
    tidepool-extract-internal
  default-language: GHC2024
  ghc-options:      -Wall
