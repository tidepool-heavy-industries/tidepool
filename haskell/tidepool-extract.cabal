cabal-version: 2.4
name:          tidepool-extract
version:       0.1.0.0
build-type:    Simple

-- Internal (unexposed) sub-library: the genuinely shared extractor
-- implementation, compiled ONCE per configuration instead of once per
-- component. Chosen over a plain top-level `library` stanza because this
-- package has no public API of its own (it's an app, not a library people
-- depend on) — an internal library says "shared build unit" without implying
-- a package-level export surface. tidepool-extract-bin and the three
-- src/-dependent test-suites below all depend on it.
library tidepool-extract-internal
  hs-source-dirs:   src
  exposed-modules:
    Tidepool.Binders
    Tidepool.Artifacts
    Tidepool.CborEncode
    Tidepool.WorkerServer
    Tidepool.DiagJson
    Tidepool.EffectSchema
    Tidepool.ExtractUtil
    Tidepool.ExtractRequest
    Tidepool.FatIface
    Tidepool.GhcPipeline
    Tidepool.Identity
    Tidepool.Introspection
    Tidepool.IR
    Tidepool.Metadata
    Tidepool.PrimOps
    Tidepool.Json
    Tidepool.Resolve
    Tidepool.Session
    Tidepool.SessionArtifacts
    Tidepool.Timing
    Tidepool.Translate
    Tidepool.TypePolicy
    Tidepool.TurnSource
  build-depends:
    base         >= 4.20 && < 5,
    ghc          >= 9.12 && < 9.13,
    ghc-boot     >= 9.12 && < 9.13,
    bytestring,
    containers,
    filepath,
    directory,
    process,
    template-haskell,
    text,
    cborg,
    mtl,
    lens,
    errors,
    witherable,
    safe
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall

test-suite constructor-arity-test
  type:             exitcode-stdio-1.0
  main-is:          ConstructorArityTest.hs
  hs-source-dirs:   test
  build-depends:
    base >= 4.20 && < 5,
    ghc >= 9.12 && < 9.13,
    tidepool-extract-internal
  default-language: GHC2024
  ghc-options:      -Wall

test-suite cell-splitter-test
  type:             exitcode-stdio-1.0
  main-is:          CellSplitterTest.hs
  hs-source-dirs:   test-cell-splitter
  build-depends:
    base >= 4.20 && < 5,
    ghc >= 9.12 && < 9.13,
    tidepool-extract-internal
  default-language: GHC2024
  ghc-options:      -Wall

-- The only default-built executable. `app/Main.hs`'s own import closure pulls
-- in no lib/Tidepool/** module (the eval stdlib is a runtime GHC include
-- path, not a host-compiled dependency — see haskell/CLAUDE.md), so
-- hs-source-dirs is just `app` and everything else comes from the internal
-- library.
executable tidepool-extract-bin
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    base >= 4.20 && < 5,
    ghc  >= 9.12 && < 9.13,
    tidepool-extract-internal,
    bytestring,
    containers,
    filepath,
    directory,
    text
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall

-- Not built by default: `cabal build` only builds tidepool-extract-bin.
-- Run: cabal test spike-extract  (needs the nix with-packages GHC on PATH;
-- `cabal build --enable-tests` builds it without running).
test-suite spike-extract
  type:             exitcode-stdio-1.0
  main-is:          Spike.hs
  hs-source-dirs:   spike-extract
  build-depends:
    base         >= 4.20 && < 5,
    ghc          >= 9.12 && < 9.13,
    ghc-boot     >= 9.12 && < 9.13,
    tidepool-extract-internal,
    bytestring,
    containers,
    filepath,
    directory,
    process,
    text,
    mtl
  default-language: GHC2024
  default-extensions: OverloadedStrings

-- Wave-3a acceptance test: drives the PRODUCTION Option-C surface
-- (Tidepool.Session + runPipelineSession + translateModuleClosed) and asserts
-- a session-binder reference reaches Core as external NVar(stableVarId).
-- Run: cabal test session-c-test  (needs the nix with-packages GHC on PATH).
test-suite session-c-test
  type:             exitcode-stdio-1.0
  main-is:          SessionCTest.hs
  hs-source-dirs:   test-session
  build-depends:
    base         >= 4.20 && < 5,
    ghc          >= 9.12 && < 9.13,
    ghc-boot     >= 9.12 && < 9.13,
    tidepool-extract-internal,
    bytestring,
    containers,
    filepath,
    directory,
    process,
    text,
    mtl
  default-language: GHC2024
  default-extensions: OverloadedStrings

-- Contract pin for the record-selector varId disambiguator (fieldParentDisamb):
-- shared field label under different parent types => distinct disambiguators;
-- non-field Name => empty disambiguator. Pins the mechanism directly (the
-- gotcha_registry canary passes pre-fix, so it does not).
-- Run: cabal test varid-mechanism-test  (needs the nix with-packages GHC on PATH).
test-suite varid-mechanism-test
  type:             exitcode-stdio-1.0
  main-is:          VarIdMechanismTest.hs
  hs-source-dirs:   test-varid
  build-depends:
    base         >= 4.20 && < 5,
    ghc          >= 9.12 && < 9.13,
    ghc-boot     >= 9.12 && < 9.13,
    tidepool-extract-internal,
    bytestring,
    containers,
    filepath,
    directory,
    process,
    text,
    mtl
  default-language: GHC2024
  default-extensions: OverloadedStrings

-- batch-turns feasibility spike (plans/post-restart/batch-turns-feasibility.md
-- §2.3): can ONE runGhc session run N sequential setTargets/depanal/load'
-- cycles with items 2..N skipping the stdlib compile? A standalone probe —
-- lifts the compile-loop mechanism from GhcPipeline.runCompile's
-- sessionVariant (that function is not exported) rather than modifying
-- GhcPipeline.hs/Session.hs/app/Main.hs.
-- Run: cabal test spike-batch  (needs the nix with-packages GHC on PATH;
-- `cabal build --enable-tests` builds it without running).
test-suite spike-batch
  type:             exitcode-stdio-1.0
  main-is:          Spike.hs
  hs-source-dirs:   spike-batch
  build-depends:
    base         >= 4.20 && < 5,
    ghc          >= 9.12 && < 9.13,
    ghc-boot     >= 9.12 && < 9.13,
    tidepool-extract-internal,
    bytestring,
    containers,
    filepath,
    directory,
    process,
    text,
    mtl,
    exceptions
  default-language: GHC2024
  default-extensions: OverloadedStrings

-- Build-products-dir spike (plans/turn-latency-state-injection.md's
-- "Direction: toward a resident compile daemon" section, prerequisite (2)):
-- does GHC's own checkOldIface recompilation checking skip an unchanged home
-- module under backend=noBackend across independent GHC sessions when
-- interfaces are written to, and read back from, a stable on-disk hidir?
-- Go/no-go probe only. See spike-build-products/Spike.hs's module haddock.
-- Run: cabal test spike-build-products  (needs the nix with-packages GHC on
-- PATH; `cabal build --enable-tests` builds it without running).
test-suite spike-build-products
  type:             exitcode-stdio-1.0
  main-is:          Spike.hs
  hs-source-dirs:   spike-build-products
  build-depends:
    base         >= 4.20 && < 5,
    ghc          >= 9.12 && < 9.13,
    ghc-boot     >= 9.12 && < 9.13,
    tidepool-extract-internal,
    containers,
    directory,
    filepath,
    process,
    text,
    exceptions
  default-language: GHC2024
  default-extensions: OverloadedStrings

-- Extract-fidelity regressions: coercion-binder erasure symmetry, intrinsic
-- recognizer module qualification, unboxed-tuple result-arity fail-loud.
-- Drives the real runPipeline + translateModuleClosed path on synthetic
-- fixture modules written under test-fidelity/work/.
-- Run: cabal test extract-fidelity-test  (needs the nix with-packages GHC on PATH).
-- A test-suite, not an executable: `cabal build` builds only the production
-- exe, and every non-production component here is a test-suite so it stays
-- that way. `Main.hs` already exits non-zero unless every check passes, which
-- is exactly the exitcode-stdio-1.0 contract.
-- Reaches the extractor through `tidepool-extract-internal` rather than
-- re-listing src/ modules on its own hs-source-dirs — the whole point of the
-- internal library is that the extractor compiles ONCE per configuration.
-- Property coverage for "Tidepool.Swarm"'s 'Cycles' budget currency
-- (operator's type-level review, 2026-08-17): the conservation law
-- 'splitAllowance' is supposed to hold by construction, checked against many
-- random inputs rather than one pinned scenario. Deliberately independent of
-- tidepool-extract-internal — this is plain-GHC business logic, not the
-- extractor pipeline, so it costs no extract compile. QuickCheck itself is
-- not in the nix with-packages GHC env and resolves from Hackage at the
-- project's pinned index-state (cabal.project's index-state) — the same
-- pattern cborg/half already use (see haskell/CLAUDE.md's toolchain
-- section); cabal.project.freeze grows the matching constraint entries the
-- first time this stanza is built.
-- Run: cabal test swarm-spec-test  (needs the nix with-packages GHC on PATH).
test-suite swarm-spec-test
  type:             exitcode-stdio-1.0
  main-is:          SwarmSpecTest.hs
  hs-source-dirs:   lib, test-swarm
  other-modules:
    Tidepool.Swarm
    SwarmSpec
  build-depends:
    base       >= 4.20 && < 5,
    QuickCheck >= 2.14 && < 2.16
  default-language: GHC2024
  default-extensions:
    OverloadedStrings
    DeriveFunctor
    DeriveFoldable
    DeriveTraversable
  ghc-options:      -Wall

-- Generates test/corpus_cbor/oracle.json: the GHC-computed expected value
-- for every "Corpus" binding, the GATING referee real_core_corpus.rs
-- (tidepool-codegen) compares the JIT against. Run via regen-corpus.sh
-- (which also regenerates the CBOR fixtures from the same source) — not a
-- pass/fail test, but a `test-suite` stanza like the other non-default
-- extras above so it stays out of a bare `cabal build`; `cabal run
-- corpus-oracle-gen -- <output-path>` builds and runs it directly.
-- Deliberately independent of tidepool-extract-internal: this is plain-GHC
-- execution of "Corpus" itself, not the extractor pipeline, so it costs no
-- extract compile.
test-suite corpus-oracle-gen
  type:             exitcode-stdio-1.0
  main-is:          GenOracle.hs
  hs-source-dirs:   test/corpus
  other-modules:    Corpus
  build-depends:
    base >= 4.20 && < 5
  default-language: GHC2024

test-suite extract-fidelity-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test-fidelity
  other-modules:
    Fidelity.Harness
    Fidelity.Erasure
    Fidelity.Recognizers
    Fidelity.PrimopArity
    Fidelity.MetadataCoverage
    Fidelity.ClosureTier
    Fidelity.TopoRecovery
    Fidelity.ExtractRequest
    Fidelity.MissingFields
  build-depends:
    tidepool-extract-internal,
    base         >= 4.20 && < 5,
    ghc          >= 9.12 && < 9.13,
    ghc-boot     >= 9.12 && < 9.13,
    bytestring,
    containers,
    filepath,
    directory,
    process,
    text,
    mtl
  default-language: GHC2024
  default-extensions: OverloadedStrings
