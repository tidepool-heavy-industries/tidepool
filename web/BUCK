load("@prelude//:rules.bzl", "genrule")

# Project the npm manifests into their own content-addressed artifact. Changes
# to other harness or web sources rerun this cheap projection without changing
# the dependency installation inputs.
genrule(
    name = "web_manifests",
    srcs = ["//third-party/rust:matched_harness_source"],
    out = ".",
bash = """set -euo pipefail
SOURCE_ROOT="$PWD/$(location //third-party/rust:matched_harness_source)"
shopt -s nullglob
WEB_SOURCES=("$SOURCE_ROOT"/*/web)
if [[ ${#WEB_SOURCES[@]} -ne 1 || ! -f "${WEB_SOURCES[0]}/package.json" || ! -f "${WEB_SOURCES[0]}/package-lock.json" ]]; then
    echo "expected one matched harness web source tree under $SOURCE_ROOT" >&2
    exit 1
fi
SOURCE="${WEB_SOURCES[0]}"
OUTPUT="$PWD/$OUT"
mkdir -p "$OUTPUT"
cp "$SOURCE/package.json" "$SOURCE/package-lock.json" "$OUTPUT/"
""",
    visibility = ["PUBLIC"],
)

# Keep dependency installation separate from source compilation: only the
# projected manifests and pinned cache define npm's closure.
genrule(
    name = "npm_dependencies",
    srcs = [
        ":web_manifests",
        "toolchains//:npm_cache",
    ],
    out = ".",
    bash = """set -euo pipefail
NODE='$(exe toolchains//:node)'
NPM='$(exe toolchains//:npm)'
NPM_CACHE="$PWD/$(location toolchains//:npm_cache)"
SOURCE="$PWD/$(location :web_manifests)"
OUTPUT="$PWD/$OUT"
export PATH="${NODE%/*}:$PATH"
export CI=1 TZ=UTC npm_config_update_notifier=false npm_config_logs_dir="$TMP/npm-logs"
mkdir -p "$TMP/npm"
cp "$SOURCE/package.json" "$SOURCE/package-lock.json" "$TMP/npm/"
cd "$TMP/npm"
"$NPM" ci --offline --ignore-scripts --cache "$NPM_CACHE" --no-audit --no-fund
cp -a node_modules/. "$OUTPUT/"
""",
    visibility = ["PUBLIC"],
)

genrule(
    name = "dist",
    srcs = [
        "//third-party/rust:matched_harness_source",
        ":npm_dependencies",
    ],
    out = ".",
    bash = """set -euo pipefail
NODE='$(exe toolchains//:node)'
NPM='$(exe toolchains//:npm)'
SOURCE_ROOT="$PWD/$(location //third-party/rust:matched_harness_source)"
shopt -s nullglob
WEB_SOURCES=("$SOURCE_ROOT"/*/web)
if [[ ${#WEB_SOURCES[@]} -ne 1 ]]; then
    echo "expected one matched harness web source tree under $SOURCE_ROOT" >&2
    exit 1
fi
SOURCE="${WEB_SOURCES[0]}"
NPM_DEPS="$PWD/$(location :npm_dependencies)"
OUTPUT="$PWD/$OUT"
export PATH="${NODE%/*}:$PATH"
export CI=1 TZ=UTC npm_config_update_notifier=false npm_config_logs_dir="$TMP/npm-logs"
mkdir -p "$TMP/web"
cp -a "$SOURCE/." "$TMP/web/"
mkdir -p "$TMP/web/node_modules"
cp -a "$NPM_DEPS/." "$TMP/web/node_modules/"
cd "$TMP/web"
"$NPM" run build
mkdir -p "$OUTPUT/web"
cp -a dist/. "$OUTPUT/web/"

""",
    visibility = ["PUBLIC"],
)
