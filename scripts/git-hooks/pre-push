#!/usr/bin/env bash
# Pre-push hook: run the canonical formatting, lint, and default test gate.
# Block push if either fails. Skip with `git push --no-verify` if you must.
#
# Install: scripts/install-hooks.sh
# Bypass:  TIDEPOOL_SKIP_PRE_PUSH=1 git push   (or --no-verify)

set -e

if [[ "${TIDEPOOL_SKIP_PRE_PUSH:-}" == "1" ]]; then
  echo "[pre-push] TIDEPOOL_SKIP_PRE_PUSH=1, skipping checks." >&2
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-push] just check" >&2
if command -v just >/dev/null 2>&1; then
  CHECK_CMD=(just check)
else
  CHECK_CMD=(nix develop --command just check)
fi
if ! "${CHECK_CMD[@]}"; then
  echo "" >&2
  echo "[pre-push] FAILED. Fix the reported check, or bypass with TIDEPOOL_SKIP_PRE_PUSH=1." >&2
  exit 1
fi

echo "[pre-push] OK" >&2
