#!/usr/bin/env bash
# Pre-push hook: checks are opt-in; ordinary pushes do not launch a build.
#
# Install: scripts/install-hooks.sh
# Check:   TIDEPOOL_CHECK_PRE_PUSH=1 git push

set -e

if [[ "${TIDEPOOL_CHECK_PRE_PUSH:-}" != "1" ]]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-push] just check" >&2
if command -v just >/dev/null 2>&1; then
  CHECK_CMD=(just check)
else
  CHECK_CMD=(nix develop --command just check)
fi
if ! "${CHECK_CMD[@]}"; then
  echo "" >&2
  echo "[pre-push] FAILED. Fix the reported check before pushing with TIDEPOOL_CHECK_PRE_PUSH=1." >&2
  exit 1
fi

echo "[pre-push] OK" >&2
