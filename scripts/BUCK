load("//build/rust:source_snapshot.bzl", "native_source_snapshot")
load("@prelude//:rules.bzl", "filegroup", "export_file", "sh_test")

filegroup(
    name = "qualification_inputs",
    srcs = {"scripts/" + source: source for source in glob(["BUCK", "*.py", "*.sh", "*.toml"])},
    visibility = ["PUBLIC"],
)

export_file(name = "embedded_web_provenance_script", src = "embedded_web_provenance.py", visibility = ["PUBLIC"])

export_file(name = "probe_opacity_checker", src = "probe-opacity-check.py", visibility = ["PUBLIC"])

filegroup(
    name = "script_test_sources",
    srcs = {"scripts/" + source: source for source in glob(["*.py", "*.sh", "*.toml", "tests/*.py"])},
)

native_source_snapshot(
    name = "script_test_resources",
    trees = [
        (":script_test_sources", ""),
        ("//:operator_test_sources", ""),
        ("//bridge/haskell:main_acceptance_script_tree", ""),
        ("//build/rust:qualification_inputs", ""),
        ("//build/package:qualification_inputs", ""),
    ],
)

sh_test(
    name = "workspace_git_resource_tests",
    test = "run-unittests.sh",
    args = ["scripts.tests.test_workspace_git_resource"],
    env = {
        "TIDEPOOL_TEST_PYTHON": "$(exe toolchains//:python)",
        "TIDEPOOL_SCRIPT_TEST_ROOT": "$(location :script_test_resources)",
        "EXOMONAD_WORKSPACE_GIT_BUNDLE": "$(location //build/rust:workspace_git_bundle)",
        "EXOMONAD_WORKSPACE_GITLINK": "$(location //build/rust:workspace_gitlink)",
        # Bundle qualification needs the immutable closure identity. Its Buck
        # projection remains a declared resource below for dependency tracking.
        "TIDEPOOL_RUNTIME_TOOLS": read_root_config("nix", "exomonad_runtime_tools", ""),
        "TIDEPOOL_SCRIPT_RESOURCE_ENV": "EXOMONAD_WORKSPACE_GIT_BUNDLE EXOMONAD_WORKSPACE_GITLINK TIDEPOOL_RUNTIME_TOOLS",
        "PATH": read_root_config("nix", "action_path"),
    },
    resources = [":script_test_resources", "//build/rust:workspace_git_bundle", "//build/rust:workspace_gitlink", "toolchains//:exomonad_runtime_tools", "toolchains//:python", "toolchains//:test_tools_closure"],
    visibility = ["PUBLIC"],
)

sh_test(
    name = "toolchain_script_tests",
    test = "run-unittests.sh",
    args = ["scripts.tests.test_lib_extract", "scripts.tests.test_native_operator_frontends", "scripts.tests.test_exomonad_launch_acceptance"],
    env = {
        "TIDEPOOL_TEST_PYTHON": "$(exe toolchains//:python)",
        "TIDEPOOL_SCRIPT_TEST_ROOT": "$(location :script_test_resources)",
        "PATH": "$(location toolchains//:test_tools)/bin:" + read_root_config("nix", "action_path"),
    },
    resources = [":script_test_resources", "toolchains//:python", "toolchains//:test_tools_closure", "toolchains//:test_tools"],
    visibility = ["PUBLIC"],
)

