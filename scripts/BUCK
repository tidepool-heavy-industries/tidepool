sh_test(
    name = "workspace_git_resource_tests",
    test = "run-unittests.sh",
    args = ["scripts.tests.test_workspace_git_resource"],
    env = {
        "TIDEPOOL_TEST_PYTHON": "$(exe toolchains//:python)",
        "TIDEPOOL_SCRIPT_TEST_ROOT": "$(location :script_test_resources)",
        "EXOMONAD_WORKSPACE_GIT_BUNDLE": "$(location //build/rust:workspace_git_bundle)",
        "EXOMONAD_WORKSPACE_GITLINK": "$(location //build/rust:workspace_gitlink)",
        "EXOMONAD_WORKSPACE_MODEL_CALL_SOURCE": "$(location toolchains//:workspace_git_resource[source_Examples_ModelCallWorkflow_hs])",
        # Bundle qualification needs the immutable closure identity. Its Buck
        # projection remains a declared resource below for dependency tracking.
        "TIDEPOOL_RUNTIME_TOOLS": read_root_config("nix", "exomonad_runtime_tools", ""),
        "EXOMONAD_OFFLINE_RUSTC": "$(exe toolchains//:rustc)",
        "EXOMONAD_OFFLINE_CC": "$(exe toolchains//:cc)",
        "TIDEPOOL_SCRIPT_RESOURCE_ENV": "EXOMONAD_WORKSPACE_GIT_BUNDLE EXOMONAD_WORKSPACE_GITLINK EXOMONAD_WORKSPACE_MODEL_CALL_SOURCE TIDEPOOL_RUNTIME_TOOLS EXOMONAD_OFFLINE_RUSTC EXOMONAD_OFFLINE_CC",
        "PATH": read_root_config("nix", "action_path"),
    },
    resources = [":script_test_resources", "//build/rust:workspace_git_bundle", "//build/rust:workspace_gitlink", "toolchains//:workspace_git_resource[source_Examples_ModelCallWorkflow_hs]", "toolchains//:exomonad_runtime_tools", "toolchains//:python", "toolchains//:test_tools_closure", "toolchains//:rustc", "toolchains//:cc"],
    visibility = ["PUBLIC"],
)

