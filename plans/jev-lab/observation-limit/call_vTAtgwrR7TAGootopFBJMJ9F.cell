{-# LANGUAGE OverloadedLabels, OverloadedRecordDot #-}
data SemanticAudit = SemanticAudit Text [(Text, Double)] [(Text, Either Text Text)] Text
auditSemanticModule :: (Member Commands effects, Member Jev effects) => Text -> Eff effects SemanticAudit
auditSemanticModule path = do
  sources <- readInvestigationSources [(path, Cmd.argv ["cat", path])]
  case sources of
    [(_, Right body)] -> do
      answer <- J.ask (J.state (object
        ["source_path" .= path, "complete_source" .= body
        , "review_intent" .= ("Find actual semantic-control defects, not style preferences. Trace how values reach effects. In particular: evidence silently truncated before a judgment; accepted rejection treated as approval; reported checks mislabeled as executed here; failed extraction replaced with empty evidence. Bounded display is fine; command exit and authority decisions belong to code." :: Text)]))
        (#truncation := J.noul "Does this module truncate deciding evidence BEFORE supplying it to Jev, without supplying a way for that judgment to retrieve the omitted material?"
          :& #approval := J.noul "Does this module treat J.accept success as approval rather than dispatching on the selected alternative?"
          :& #provenance := J.noul "Does this module label child-reported check outcomes as locally executed verification?"
          :& #empty_failure := J.noul "Does this module turn a failed evidence read/extraction into empty evidence and then continue a semantic decision as though capture succeeded?"
          :& J.Nil)
      case answer of
        Left err -> pure (SemanticAudit path [] sources ("Jev failed: " <> T.pack (show err)))
        Right response -> do
          let a = J.answers response
          let risks = [("truncation",a.truncation.yes),("approval",a.approval.yes),("provenance",a.provenance.yes),("empty_failure",a.empty_failure.yes)]
          if not (any ((>= 0.65) . snd) risks)
            then pure (SemanticAudit path risks sources "No high-scoring risk; not proof of correctness.")
            else do
              let name = T.dropEnd 3 (last (T.splitOn "/" path))
              consumers <- readInvestigationSources
                [("consumer references", Cmd.argv ["rg", "-n", "Project\\." <> name <> "|Text.take|J.accept|RanHere|ChildReported", ".shoal/Project"])
                ,("evidence types and constructors", Cmd.argv ["cat", ".shoal/Project/Evidence.hs"])
                ,("review consumer", Cmd.argv ["cat", ".shoal/Project/Review.hs"])]
              verdict <- J.ask1 (J.state (object
                ["suspect_path" .= path, "complete_suspect_source" .= body
                , "hypotheses" .= [object ["risk" .= label, "initial_score" .= score] | (label,score) <- risks, score >= 0.65]
                , "followup_sources" .= [object ["source" .= source, "body" .= either ("READ FAILED: " <>) id text] | (source,text) <- consumers]]))
                (J.choice "After tracing the actual consumers, what does this evidence establish about the suspected module?"
                  (J.alt #defect "At least one suspected behavior is present and can mislead a semantic decision or verification claim" ("supported defect" :: Text)
                    J..| J.alt #intentional "The suspected behavior is display-only, explicitly preserves provenance/failure, or is otherwise handled by its actual consumer" "handled or intentional"
                    J..| J.alt #unresolved "The evidence does not establish whether the suspected behavior has the claimed consequence" "unresolved"))
              let conclusion = case verdict of
                    Left err -> "Jev failed: " <> T.pack (show err)
                    Right v -> case J.accept J.routing v of
                      Left _ -> "Doubt: " <> J.explain J.routing v
                      Right selected -> J.handle selected
                        (#defect id J..| #intentional id J..| #unresolved id)
              pure (SemanticAudit path risks (sources ++ consumers) conclusion)
    _ -> pure (SemanticAudit path [] sources "Source read failed; not reviewed.")
let semanticModulePaths = [".shoal/Project/" <> name <> ".hs" | name <- ["Types","Actors","Work","Routing","Observe","Reflex","Evidence","Contract","Investigate","Merge","Review"]]
semanticAudits <- traverse auditSemanticModule semanticModulePaths
[(path, filter ((>= 0.65) . snd) risks, conclusion) | SemanticAudit path risks _ conclusion <- semanticAudits]

