data EditorialOutcome = EditorialStopped Text | EditorialKept Text Text | EditorialRestored Text
replaceExactDocument :: Member Commands effects => Text -> Text -> Text -> Eff effects (Either Text ())
replaceExactDocument path before after = do
  result <- Cmd.quiet (Cmd.run (Cmd.argv ["python3","-c",
    "import pathlib,sys; p=pathlib.Path(sys.argv[1]); before,after=sys.argv[2:]; assert p.read_text()==before, 'source changed; refusing overwrite'; p.write_text(after)",
    path,before,after]))
  pure (either (Left . T.pack . show) (const (Right ())) (Cmd.stdout result))
editCompletionGuidance :: (Member Commands effects, Member Jev effects) => Text -> Text -> [(Text,Text)] -> Eff effects EditorialOutcome
editCompletionGuidance context anchor candidates = do
  let path = "exomonad/examples/workspace/.exomonad/skills/exomonad-command/SKILL.md"
  readResult <- Cmd.quiet (Cmd.run (Cmd.argv ["cat",path]))
  case Cmd.stdout readResult of
    Left issue -> pure (EditorialStopped (T.pack (show issue)))
    Right original ->
      if length (T.splitOn anchor original) /= 2 then pure (EditorialStopped "Anchor absent or ambiguous; no edit.")
      else do
        let options = J.many [(name, String body, (name,body)) | (name,body) <- candidates]
              J..| J.alt #unresolved "Neither revision is supported or useful for the stated failure" ("unresolved","")
        chosen <- J.ask1 (J.state (object
          ["current_goal" .= ("Eliminate the discovery/repair turn when an agent processes a command-completion event. Prefer operational guidance over verbosity. Do not change extension defaults; another owner is fixing those." :: Text)
          , "recent_context" .= context, "existing_paragraph" .= anchor
          , "execution_evidence" .= ("A live handler used Cmd.readStdout capturedJob, two Jev stages, stored original output blocks, and finished. Cmd.stdout on the event failed: expected RunResult, actual CommandResult. This was a successful cat of a historical build log, not a failing live build." :: Text)]))
          (J.choice "Which revision best lets an agent author that continuation without repeating discovery, while staying honest about demonstrated behavior?" options)
        case chosen of
          Left err -> pure (EditorialStopped (T.pack (show err)))
          Right answer -> case J.accept J.routing answer of
            Left _ -> pure (EditorialStopped (J.explain J.routing answer))
            Right selection -> do
              let (name,replacement) = J.handle selection (J.onMany (\_ value -> value) J..| #unresolved id)
              if name == "unresolved" then pure (EditorialStopped "No supported revision.")
              else do
                let revised = T.replace anchor replacement original
                checked <- J.ask (J.state (object ["candidate" .= replacement, "observed_contract" .= ("Cmd.completion gives outcome and cleanup. Cmd.readStdout reads the retained job and returns Either OutputIssue Text. Handler needs Commands. This executed in a local record actor. Runtime enforces authority." :: Text), "recent_context" .= context]))
                  (#new_reader := J.noul "Can an agent unfamiliar with completion payloads identify the next callable operation and required input without guessing?"
                    :& #experienced_reader := J.noul "Does this add an operational distinction rather than repeat that events exist?"
                    :& #maintainer := J.noul "Does this avoid claiming stdout is complete failure evidence or captured handles grant authority?"
                    :& J.Nil)
                case checked of
                  Left err -> pure (EditorialStopped (T.pack (show err)))
                  Right response -> do
                    let a = J.answers response
                    if not (all (>= 0.7) [a.new_reader.yes,a.experienced_reader.yes,a.maintainer.yes])
                      then pure (EditorialStopped ("Reader review did not support " <> name))
                      else if T.count "```haskell" original /= T.count "```haskell" revised
                        then pure (EditorialStopped "Would alter executable example inventory.")
                        else do
                          applied <- replaceExactDocument path original revised
                          case applied of
                            Left issue -> pure (EditorialStopped issue)
                            Right () -> do
                              check <- Cmd.quiet (Cmd.run (Cmd.argv ["git","diff","--check","--",path]))
                              case Cmd.stdout check of
                                Right _ -> pure (EditorialKept name replacement)
                                Left issue -> do
                                  restored <- replaceExactDocument path revised original
                                  pure (EditorialRestored (T.pack (show issue) <> "; restore: " <> T.pack (show restored)))
let completionAnchor = "`Cmd.completion job :: R.EventSource Cmd.CommandResult` supplies one retained\nterminal event, including attachment after completion. Load `exomonad-define-actors`\nfor custom routing. Captured handles do not transfer authority; finish collectors\nwhen their remaining obligations are settled." :: Text
let completionOptions =
      [ ("compact", "`Cmd.completion job :: R.EventSource Cmd.CommandResult` supplies one retained\nterminal event, including attachment after completion. The event contains outcome\nand cleanup, not captured output: `Cmd.stdout` takes `Cmd.RunResult`, not this\npayload. Capture the original job in the handler and use `Cmd.readStdout job`\n(with `Commands` in its effect row), handling `Left` before semantic processing.\nKeep the event's outcome and cleanup alongside the selected output. Load\n`exomonad-define-actors` for handler construction and finish collectors when their\nobligations are settled. Captured handles do not transfer authority.")
      , ("steps", "`Cmd.completion job :: R.EventSource Cmd.CommandResult` supplies one retained\nterminal event, including attachment after completion. To continue automatically:\n\n1. Capture the original job in the handler; the event contains outcome and\n   cleanup, not the job or captured output.\n2. Read retained stdout with `Cmd.readStdout job`; include `Commands` in the\n   handler's effect row. Handle `Left` explicitly rather than substituting empty\n   evidence. `Cmd.stdout` accepts `Cmd.RunResult`, not the completion payload.\n3. Interpret the available evidence and execute the prepared follow-up in that\n   handler. Preserve outcome and cleanup separately from a semantic judgment;\n   stdout alone is not a complete diagnostic bundle for commands using stderr.\n4. Retain the result and finish the collector when its obligations are settled.\n\nUse `exomonad-define-actors` for handler construction. Captured handles do not\ntransfer authority.")
      ] :: [(Text, Text)]
editorialContext <- reflect 3
let editorialContextText = either (T.pack . show) (T.intercalate "\n" . concatMap (\turn -> [T.pack (show role) <> ": " <> text | TurnMessage role text <- turnItems turn])) editorialContext
editorialResult <- editCompletionGuidance editorialContextText completionAnchor completionOptions
editorialResult

