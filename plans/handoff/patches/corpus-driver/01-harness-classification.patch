+        .filter(|rep| matches!(rep, RuntimeRep::LiftedRef | RuntimeRep::UnliftedRef))
+        .count();
+    let scalar = arguments
+        .iter()
+        .filter(|rep| {
+            !matches!(
+                rep,
+                RuntimeRep::Void | RuntimeRep::LiftedRef | RuntimeRep::UnliftedRef
+            )
+        })
+        .count();
+    match (managed, scalar) {
+        (0, 0) => Ok(()),
+        (0, scalar) => Err(format!(
+            "entry takes {scalar} scalar argument(s) {arguments:?}; not a closed program"
+        )),
+        (managed, _) => Err(format!(
+            "entry takes {managed} managed argument(s) {arguments:?}; not a closed program"
+        )),
