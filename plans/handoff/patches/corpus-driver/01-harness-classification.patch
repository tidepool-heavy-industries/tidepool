+/// decides whether a top is a closed program. An entry this predicate admits
+/// but the engine refuses stays an ordinary execution failure.
+fn entry_closure(program: &PreparedProgram, entry: ValueId) -> Result<(), String> {
+    let signature = program
+        .bindings()
+        .iter()
+        .flat_map(|group| match group {
+            Group::NonRecursive(top) => std::slice::from_ref(top),
+            Group::Recursive(tops) => tops.as_slice(),
+        })
+        .find(|top| top.binding.id == entry)
+        .and_then(|top| match &top.binding.rhs {
+            HeapRhs::Function { signature, .. } => program.signatures().get(signature.0 as usize),
+            _ => None,
+        });
+    match signature {
+        Some(signature) => closure_of_arguments(&signature.arguments),
+        None => Ok(()),
+    }
