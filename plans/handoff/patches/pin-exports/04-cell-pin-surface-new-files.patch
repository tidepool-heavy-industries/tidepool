diff --git a/haskell/test-cell-pin-surface/Main.hs b/haskell/test-cell-pin-surface/Main.hs
new file mode 100644
--- /dev/null
+++ b/haskell/test-cell-pin-surface/Main.hs
@@ -0,0 +1,79 @@
+-- | Cell-pin renderability probe for a notebook surface.
+--
+-- A statement binder's checked type is rendered with the cell's name context
+-- ('renderCellPinType') and replanted into the staged compile. An audited
+-- module that exports a value or constructor whose type names an entity the
+-- cell cannot name yields a pin such as
+-- @Tidepool.Agent.Reply.Internal.Reply result -> ...@, which the staged compile
+-- rejects as out of scope.
+--
+-- The driver supplies the exact cell header (pragmas, @module CellPinProbe@,
+-- imports) and include path. The header is compiled through the production
+-- pipeline, the pin name context is built from its reader environment exactly
+-- as 'capturedCellBinderPins' builds it, and every binder-reachable type of
+-- every audited export is checked.
+--
+-- Output: one line per unresolved name,
+-- @module<TAB>export<TAB>unresolved name<TAB>rendered pin@.
+module Main (main) where
+
+import GHC
+  ( TyThing, findModule, getModuleInfo, lookupName, mkModuleName, modInfoExports )
+import GHC.Driver.Env.Types (HscEnv (hsc_unit_env))
+import GHC.Driver.Monad (Session (..), reflectGhc)
+import GHC.Types.Name (Name, nameModule_maybe, nameOccName)
+import GHC.Types.Name.Occurrence (occNameString)
+import GHC.Types.Name.Ppr (mkNamePprCtx)
+import GHC.Unit.Module (moduleName, moduleNameString)
+import GHC.Utils.Outputable (NamePprCtx, PromotionTickContext (..))
+
+import Tidepool.GhcPipeline
+  ( PipelineResult (..), cellPinCandidateTypes, renderCellPinType
+  , runPipeline, unresolvedCellPinNames )
+
+import Control.Monad (forM, forM_)
+import Data.IORef (newIORef)
+import Data.List (intercalate)
+import System.Directory (createDirectoryIfMissing)
+import System.Environment (getArgs)
+import System.Exit (exitFailure)
+import System.FilePath ((</>))
+import System.IO (hPutStrLn, stderr)
+
+main :: IO ()
+main = do
+  arguments <- getArgs
+  (headerPath, audited, includes) <- case break (== "--") arguments of
+    (header : modules@(_ : _), "--" : includes) -> pure (header, modules, includes)
+    _ -> do
+      hPutStrLn stderr "usage: cell-pin-surface-test HEADER.hs AUDIT-MODULE... -- INCLUDE-DIR..."
+      exitFailure
+  header <- readFile headerPath
+  let work = "cell-pin-probe"
+      probePath = work </> "CellPinProbe.hs"
+  createDirectoryIfMissing True work
+  writeFile probePath (header ++ "\ncellPinProbe :: ()\ncellPinProbe = ()\n")
+  compiled <- runPipeline probePath (work : includes)
+  let names = mkNamePprCtx (PromTickCtx True True)
+        (hsc_unit_env (prHscEnv compiled)) (prTargetRdrEnv compiled)
+  session <- Session <$> newIORef (prHscEnv compiled)
+  findings <- flip reflectGhc session $ fmap concat $ forM audited $ \audit -> do
+    modu <- findModule (mkModuleName audit) Nothing
+    exports <- maybe [] modInfoExports <$> getModuleInfo modu
+    fmap concat $ forM exports $ \export -> do
+      found <- lookupName export
+      pure (maybe [] (findingsFor names audit export) found)
+  forM_ findings (putStrLn . intercalate "\t")
+
+findingsFor
+  :: NamePprCtx -> String -> Name -> TyThing -> [[String]]
+findingsFor names audit export thing =
+  [ [audit, occNameString (nameOccName export), qualified name, renderCellPinType names ty]
+  | ty <- cellPinCandidateTypes thing
+  , name <- unresolvedCellPinNames names ty
+  ]
+
+qualified :: Name -> String
+qualified name = case nameModule_maybe name of
+  Just modu -> moduleNameString (moduleName modu) ++ "." ++ occNameString (nameOccName name)
+  Nothing -> occNameString (nameOccName name)
diff --git a/tidepool/src/actor_host/cell_pin_surface_tests.rs b/tidepool/src/actor_host/cell_pin_surface_tests.rs
new file mode 100644
