+//! Cell-pin renderability of the Shoal root workbench surface.
+//!
+//! A statement binder's checked type is rendered with the cell's name context
+//! and replanted into the staged compile. A facade export whose type names an
+//! entity outside that scope yields a pin the staged compile cannot resolve,
+//! such as `Tidepool.Agent.Reply.Internal.Reply result`. The Haskell probe
+//! (`cell-pin-surface-test` in `haskell/tidepool-extract.cabal`) checks every
+//! binder-reachable export type against the cell header assembled here from
+//! the same constants the root workbench uses.
+
+use std::process::Command;
+
+use super::*;
+
+const PROBE_ENV: &str = "TIDEPOOL_CELL_PIN_SURFACE_PROBE";
+const AUDITED_MODULES: &[&str] = &[WORKBENCH_SURFACE_MODULE, DRIVER_MODULE];
+
+fn shoal_cell_header() -> (String, Vec<PathBuf>) {
+    let declarations = shoal_effect_declarations();
+    let effects = tidepool_mcp::ensure_effects_module(&declarations).unwrap();
+    let mut include = effects.include_paths().to_vec();
+    include.push(
+        tidepool_testing::eval_harness::repo_root()
+            .join("haskell")
+            .join("actors"),
+    );
+    include.push(tidepool_testing::eval_harness::prelude_path());
+    let preamble = insert_preamble_imports(
+        &tidepool_mcp::build_preamble_with_companions_hiding(
+            &declarations,
+            false,
+            tidepool_mcp::CompanionImports::Omit,
+            SHOAL_REPLACED_EFFECT_NAMES,
+        ),
+        DRIVER_MODULE,
+    );
+    let header = insert_preamble_imports(&preamble, &SHOAL_CELL_IMPORTS.join("\n"))
+        .replacen("module Expr where", "module CellPinProbe where", 1);
+    assert!(header.contains("module CellPinProbe where"), "{header}");
+    (header, include)
+}
+
+#[test]
+fn shoal_workbench_exports_have_renderable_cell_pins() {
+    let Some(probe) = std::env::var_os(PROBE_ENV) else {
+        return;
+    };
+    let (header, include) = shoal_cell_header();
+    let work = tempfile::tempdir().unwrap();
+    let header_path = work.path().join("CellPinProbe.header.hs");
+    std::fs::write(&header_path, header).unwrap();
+    let output = Command::new(probe)
+        .current_dir(work.path())
+        .arg(&header_path)
+        .args(AUDITED_MODULES)
+        .arg("--")
+        .args(&include)
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "cell-pin probe failed to run:\n{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    let findings = stdout
+        .lines()
+        .filter(|line| !line.is_empty())
+        .collect::<Vec<_>>();
+    assert!(
+        findings.is_empty(),
+        "Shoal exports whose binder pins name entities a Shoal cell cannot \
+         resolve; export the named type from the facade or keep it out of the \
+         exported signature (module, export, unresolved name, rendered pin):\n{}",
+        findings.join("\n")
+    );
+}
