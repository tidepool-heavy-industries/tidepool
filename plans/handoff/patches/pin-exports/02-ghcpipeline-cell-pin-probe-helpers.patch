+cellPinNames :: NamePprCtx -> NamePprCtx
+cellPinNames originalNames = originalNames
+  { queryQualifyName = \modu occurrence ->
+      case parseSessionModule (moduleNameString (moduleName modu)) of
+        Just _ -> NameQual (moduleName modu)
+        Nothing -> queryQualifyName originalNames modu occurrence
+  }
+
+-- | Names 'renderCellPinType' would print that the cell scope cannot resolve.
+-- GHC qualifies such a name with its defining module, which the staged
+-- compile has not imported. Synonyms are walked as written because 'ppr'
+-- prints them unexpanded; kinds are skipped because pins omit foralls.
+unresolvedCellPinNames :: NamePprCtx -> Type -> [Name]
+unresolvedCellPinNames originalNames = nub . filter unresolved . written
+  where
+    names = cellPinNames originalNames
+    unresolved name = case nameModule_maybe name of
+      Just modu | not (isBuiltInSyntax name) ->
+        case queryQualifyName names modu (nameOccName name) of
+          NameNotInScope1 -> True
+          NameNotInScope2 -> True
+          _ -> False
+      _ -> False
+    written ty = case ty of
+      TyConApp tc args -> tyConName tc : concatMap written args
+      AppTy function argument -> written function ++ written argument
+      FunTy _ _ argument result -> written argument ++ written result
+      ForAllTy _ body -> written body
+      CastTy inner _ -> written inner
+      _ -> []
+
+-- | Types a monomorphic statement binder can take from one exported entity.
+-- A value contributes its body after quantifiers and context (a binder
+-- instantiates it, so the context is solved away); the body contains every
+-- argument, result, and bound effect result. A constructor contributes its
+-- fields, which pattern binders expose.
+cellPinCandidateTypes :: TyThing -> [Type]
+cellPinCandidateTypes thing = map stabilizeEffectRows $ case thing of
+  AnId identifier ->
+    let (_, _, body) = tcSplitSigmaTy (idType identifier) in [body]
+  AConLike (RealDataCon con) -> map scaledThing (dataConOrigArgTys con)
+  _ -> []
 
 -- Stop at an 'Id': descending through its type/name graph is both unnecessary
 -- and dramatically larger than the typechecked syntax tree that owns it.
