@@ -480,3 +480,24 @@
     tidepool-extract-internal
   default-language: GHC2024
   ghc-options:      -Wall
+
+-- Cell-pin renderability of a notebook surface: every type a monomorphic
+-- statement binder can take from an audited module's exports must render,
+-- with the cell's own name context, using only names that cell resolves.
+-- Driven by tidepool's actor_host cell_pin_surface_tests, which supplies the
+-- production cell header and include path:
+--   cell-pin-surface-test HEADER.hs AUDIT-MODULE... -- INCLUDE-DIR...
+-- Prints one TSV finding per unresolved name; exits non-zero only on misuse
+-- or compile failure, so the driver owns the verdict.
+test-suite cell-pin-surface-test
+  type:             exitcode-stdio-1.0
+  main-is:          Main.hs
+  hs-source-dirs:   test-cell-pin-surface
+  build-depends:
+    base         >= 4.20 && < 5,
+    ghc          >= 9.12 && < 9.13,
+    directory,
+    filepath,
+    tidepool-extract-internal
+  default-language: GHC2024
+  ghc-options:      -Wall
