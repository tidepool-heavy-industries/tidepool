load(":authored_sources.bzl", "declare_authored_haskell_sources")
load("@prelude//:rules.bzl", "export_file", "filegroup")

export_file(
    name = "facade_agent_spec",
    src = ".exomonad/AgentSpec.hs",
    out = "AgentSpec.hs",
    visibility = ["PUBLIC"],
)

export_file(
    name = "facade_review_prompt",
    src = ".exomonad/prompts/review.md",
    visibility = ["PUBLIC"],
)

filegroup(
    name = "facade_scaffold_sources",
    srcs = {source: source for source in glob([
        "flake.nix",
        ".exomonad/AgentSpec.hs",
        ".exomonad/WORKBENCH.md",
        ".exomonad/prompts/**/*",
    ])},
    visibility = ["PUBLIC"],
)

export_file(
    name = "facade_task_prompt",
    src = ".exomonad/prompts/task.md",
    visibility = ["PUBLIC"],
)

export_file(
    name = "facade_workbench_skill",
    src = ".exomonad/skills/exomonad-workbench/SKILL.md",
    visibility = ["PUBLIC"],
)

filegroup(
    name = "shipped_skills",
    srcs = {source: source for source in glob([".exomonad/skills/**/*"])},
    visibility = ["PUBLIC"],
)

# Compile-time inputs for the facade's published-example tests.
filegroup(
    name = "facade_test_sources",
    srcs = {source: source for source in glob(["flake.nix", "flake.lock", ".exomonad/**/*.hs", ".exomonad/**/*.md", ".exomonad/**/*.json", ".exomonad/config.toml"])},
    visibility = ["PUBLIC"],
)

filegroup(
    name = "qualification_inputs",
    srcs = {"exomonad/examples/workspace/" + source: source for source in glob(["BUCK", "*.bzl", "flake.nix", ".exomonad/**/*.hs", ".exomonad/**/*.md", ".exomonad/**/*.toml", ".exomonad/**/*.json", ".exomonad/**/*.nix"])},
    visibility = ["PUBLIC"],
)

# Cabal component resources include authored source and adjacent runtime data.
declare_authored_haskell_sources(glob([
    ".exomonad/**/*.hs",
    ".exomonad/**/*.hs-boot",
    ".exomonad/**/*.json",
    ".exomonad/**/*.cbor",
    ".exomonad/**/*.txt",
]))
