load("@prelude//:rules.bzl", "export_file", "filegroup")

export_file(
    name = "facade_agent_spec",
    src = ".exomonad/AgentSpec.hs",
    visibility = ["PUBLIC"],
)

export_file(
    name = "facade_review_prompt",
    src = ".exomonad/prompts/review.md",
    visibility = ["PUBLIC"],
)

filegroup(
    name = "facade_scaffold_sources",
    srcs = {source: source for source in glob([
        "flake.nix",
        ".exomonad/AgentSpec.hs",
        ".exomonad/WORKBENCH.md",
        ".exomonad/prompts/**/*",
    ])},
    visibility = ["PUBLIC"],
)

export_file(
    name = "facade_task_prompt",
    src = ".exomonad/prompts/task.md",
    visibility = ["PUBLIC"],
)

export_file(
    name = "facade_workbench_skill",
    src = ".exomonad/skills/exomonad-workbench/SKILL.md",
    visibility = ["PUBLIC"],
)

# Compile-time inputs for the facade's published-example tests.
filegroup(
    name = "facade_test_sources",
    srcs = {source: source for source in glob([".exomonad/**/*.hs", ".exomonad/**/*.md", ".exomonad/**/*.json", ".exomonad/config.toml"])},
    visibility = ["PUBLIC"],
)

filegroup(
    name = "qualification_inputs",
    srcs = {"exomonad/examples/workspace/" + source: source for source in glob(["BUCK", "flake.nix", ".exomonad/**/*.hs", ".exomonad/**/*.md", ".exomonad/**/*.toml", ".exomonad/**/*.json", ".exomonad/**/*.nix"])},
    visibility = ["PUBLIC"],
)

# Package-owned projections for Cabal-declared authored modules.
for source in glob([".exomonad/**/*.hs"]):
    relative = source[len(".exomonad/"):]
    export_file(
        name = "authored_haskell_" + relative.replace("/", "_").replace(".", "_").replace("-", "_"),
        src = source,
        visibility = ["PUBLIC"],
    )
