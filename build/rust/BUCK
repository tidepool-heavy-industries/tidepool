load("@prelude//:rules.bzl", "export_file", "filegroup", "python_bootstrap_binary", "sh_test")

rust_filegroup(
    name = "proptest_persistence_sources",
    mapped_srcs = {
        "tests/proptest-persistence/src/lib.rs": "build/rust/tests/proptest-persistence/src/lib.rs",
    },
)

tidepool_rust_binary(
    name = "proptest_persistence_probe",
    package_name = "native-proptest-control",
    package_dir = "build/rust/tests/proptest-persistence",
    version = "0.0.0",
    crate_root = "build/rust/tests/proptest-persistence/src/lib.rs",
    edition = "2021",
    srcs_filegroup = ":proptest_persistence_sources",
    deps = ["//third-party/rust:proptest"],
    rustc_flags = ["--test"],
    required_test_modules = ["build/rust/tests/proptest-persistence/src/lib.rs"],
)

python_bootstrap_binary(
    name = "proptest_persistence_control",
    main = "proptest-persistence.py",
)

sh_test(
    name = "proptest_persistence_tests",
    test = ":proptest_persistence_control",
    args = [
        "--binary", "$(location :proptest_persistence_probe)",
        "--runner", "$(location :isolated_libtest_source)",
    ],
    resources = [":proptest_persistence_probe", ":isolated_libtest_source"],
    visibility = ["PUBLIC"],
)

python_bootstrap_binary(
    name = "isolated_libtest",
    main = "isolated-libtest.py",
    visibility = ["PUBLIC"],
)

export_file(
    name = "isolated_libtest_source",
    src = "isolated-libtest.py",
    visibility = ["PUBLIC"],
)

export_file(
    name = "compile_fail_runner",
    src = "compile-fail.py",
    visibility = ["PUBLIC"],
)

export_file(name = "source_snapshot_driver", src = "source_snapshot.py", visibility = ["PUBLIC"])
export_file(name = "workspace_gitlink", src = "//:workspace_gitlink", visibility = ["PUBLIC"])
export_file(name = "workspace_git_bundle", src = "toolchains//:workspace_git_resource[workspace_bundle]", visibility = ["PUBLIC"])

native_source_snapshot(
    name = "native_qualification_sources",
    trees = NATIVE_QUALIFICATION_TREES,
    visibility = ["PUBLIC"],
)

filegroup(
    name = "qualification_inputs",
    srcs = {"build/rust/" + source: source for source in glob(["BUCK", "*.bzl", "*.py", "tests/**/*.rs"])},
    visibility = ["PUBLIC"],
)

export_file(name = "native_checks_driver", src = "checks.py", visibility = ["PUBLIC"])
export_file(name = "test_source_rustc", src = "test-source-rustc.py", visibility = ["PUBLIC"])

