load("@prelude//:rules.bzl", "export_file", "sh_test")

export_file(
    name = "source",
    src = "WorkerSmoke.hs",
    visibility = ["PUBLIC"],
)

# Exercise the assembled runtime package through its public frontend. A
# successful prepared artifact proves the packaged worker started GHC and
# compiled the declared source fixture.
sh_test(
    name = "packaged_worker_compile",
    test = "worker-compile-smoke.sh",
    args = [
        "$(location //build/package:matched_runtime_bundle)",
        "$(location :source)",
    ],
    resources = [
        "//build/package:matched_runtime_bundle",
        ":source",
    ],
    env = {
        "PATH": read_root_config("nix", "ghc_bin") + ":" + read_root_config("nix", "action_path"),
        "TIDEPOOL_COMPILER_DEPLOYMENT": read_root_config("nix", "runtime_stdlib_extract", "") + "/share/exomonad/compiler-deployment.json",
        "TIDEPOOL_GHC_LIBDIR": read_root_config("nix", "runtime_stdlib_ghc_libdir", ""),
    },
    visibility = ["PUBLIC"],
)
