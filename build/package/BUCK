tidepool_runtime_shared_libraries(
    name = "tidepool_extract_runtime_libraries",
    library = "//bridge/haskell:tidepool_extract_internal",
    visibility = ["PUBLIC"],
)

# Generate authority for the exact frontend and worker paths used by focused
# Rust tests without pulling in the complete browser-bearing runtime bundle.
genrule(
    name = "compiler_deployment",
    srcs = [
        "//tidepool/extract-cmd:tidepool-extract",
        "//bridge/haskell:tidepool_extract_bin",
        ":tidepool_extract_runtime_libraries",
    ],
    out = "compiler-deployment.json",
    env = {
        "TIDEPOOL_GHC_LIBDIR": read_root_config("nix", "ghc_libdir"),
    },
    bash = """set -euo pipefail
FRONTEND="$(exe //tidepool/extract-cmd:tidepool-extract)"
WORKER="$(exe //bridge/haskell:tidepool_extract_bin)"
RUNTIME_LIBRARIES="$PWD/$(location :tidepool_extract_runtime_libraries)"
mkdir -p "$TMP/worker-libraries"
for library in "$RUNTIME_LIBRARIES"/*; do
    test -e "$library"
    cp -L "$library" "$TMP/worker-libraries/"
done
TIDEPOOL_EXTRACT_WORKER="$WORKER" \
  LD_LIBRARY_PATH="$TMP/worker-libraries${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
  "$FRONTEND" --compiler-deployment-manifest "$PWD/$OUT"
""",
    visibility = ["PUBLIC"],
)

genrule(
    name = "embedded_web_provenance",
    srcs = [
        "//third-party/rust:matched_harness_source_revision",
        "root//:workspace_cargo_manifest",
        "root//:workspace_cargo_lock",
        "root//bridge/facade:facade_cargo_manifest",
        "root//:workspace_flake_lock",
        "root//:workspace_flake_nix",
        "root//:embedded_web_provenance_script",
    ],
    out = "harness-source-revision.txt",
    bash = """set -euo pipefail
SOURCE="$TMP/provenance-source"
mkdir -p "$SOURCE/bridge/facade" "$SOURCE/scripts"
cp "$PWD/$(location root//:workspace_cargo_manifest)" "$SOURCE/Cargo.toml"
cp "$PWD/$(location root//:workspace_cargo_lock)" "$SOURCE/Cargo.lock"
cp "$PWD/$(location root//bridge/facade:facade_cargo_manifest)" "$SOURCE/bridge/facade/Cargo.toml"
cp "$PWD/$(location root//:workspace_flake_lock)" "$SOURCE/flake.lock"
cp "$PWD/$(location root//:workspace_flake_nix)" "$SOURCE/flake.nix"
cp "$PWD/$(location root//:embedded_web_provenance_script)" "$SOURCE/scripts/embedded_web_provenance.py"
"$(exe toolchains//:python)" "$SOURCE/scripts/embedded_web_provenance.py" --check --root "$SOURCE" --actual-source-revision "$PWD/$(location //third-party/rust:matched_harness_source_revision)" --output "$PWD/$OUT"
""",
    visibility = ["PUBLIC"],
)

# Native compiler bytes travel with the host; the selected final bundle path
# supplies deployment provenance when its frontend generates the manifest.

native_runtime_bundle(name = "native_runtime_bundle", catalog_backed = False)

native_runtime_bundle(name = "native_catalog_runtime_bundle", catalog_backed = True)
