haskell_library(
    name = "assignment_internal",
    srcs = {"Tidepool/Agent/Assignment/Internal.hs": "lib/Tidepool/Agent/Assignment/Internal.hs"},
    compiler_flags = assignment_component_flags("-XOverloadedStrings"),
    visibility = ["PUBLIC"],
)

haskell_binary(
    name = "tidepool_extract_bin",
    srcs = {"Main.hs": "app/Main.hs"},
    deps = [":tidepool_extract_internal"],
    compiler_flags = extractor_binary_flags("-XOverloadedStrings"),
    linker_flags = extractor_binary_link_flags() + ["-with-rtsopts=-T"],
    visibility = ["PUBLIC"],
)

# This focused native executable compiles the same encoder test source that
# Cabal exposes as execution-schema-encode. Building it checks the component;
# running it remains a separate test action.
haskell_binary(
    name = "execution_schema_encode_test",
    srcs = {"Main.hs": "test-execution-schema-encode/Main.hs"},
    deps = [":tidepool_extract_internal"],
    compiler_flags = encoder_test_flags("-XOverloadedStrings"),
    linker_flags = encoder_test_link_flags(),
    visibility = ["PUBLIC"],
)

haskell_binary(
    name = "compile_input_policy_test",
    srcs = {"Main.hs": "test-compile-input-policy/Main.hs"},
    deps = [":tidepool_extract_internal"],
    compiler_flags = extractor_binary_flags("-XOverloadedStrings"),
    linker_flags = extractor_binary_link_flags(),
    visibility = ["PUBLIC"],
)

sh_test(
    name = "compile_input_policy",
    test = ":compile_input_policy_test",
    visibility = ["PUBLIC"],
)

sh_test(
    name = "execution_schema_encode",
    test = ":execution_schema_encode_test",
    visibility = ["PUBLIC"],
)

# The test compiles each original family producer once and shares its immutable
# axioms across conflict cases. --benchmark measures only pure validation.
haskell_binary(
    name = "family_consistency_test",
    srcs = {"Main.hs": "test-family-consistency/Main.hs"},
    deps = [":tidepool_extract_internal"],
    compiler_flags = extractor_binary_flags("-package", "process"),
    linker_flags = extractor_binary_link_flags() + ["-package", "process", "-rtsopts", "-with-rtsopts=-T"],
    visibility = ["PUBLIC"],
)

sh_test(
    name = "family_consistency",
    test = ":family_consistency_test",
    env = {
        "PATH": read_root_config("nix", "ghc_bin") + ":" + read_root_config("nix", "action_path"),
        "TIDEPOOL_GHC_LIBDIR": read_root_config("nix", "ghc_libdir"),
    },
    visibility = ["PUBLIC"],
)

# The native suites consume the same sources and fixture paths as Cabal.
haskell_binary(
    name = "planned_declaration_test",
    srcs = {"Main.hs": "test-planned-declaration/Main.hs"},
    deps = [":tidepool_extract_internal"],
    compiler_flags = extractor_binary_flags("-package", "mtl"),
    linker_flags = extractor_binary_link_flags() + ["-package", "mtl"],
    visibility = ["PUBLIC"],
)

filegroup(
    name = "planned_declaration_fixtures",
    srcs = glob(["test-planned-declaration/fixtures/*.hs"]),
)

sh_test(
    name = "planned_declaration",
    test = "test-with-fixtures.sh",
    args = [
        "$(exe :planned_declaration_test)",
        "$(location :planned_declaration_fixtures)",
    ],
    resources = [":planned_declaration_test", ":planned_declaration_fixtures"],
    env = {
        "PATH": read_root_config("nix", "ghc_bin") + ":" + read_root_config("nix", "action_path"),
        "TIDEPOOL_GHC_LIBDIR": read_root_config("nix", "ghc_libdir"),
    },
    test_rule_timeout_ms = 300000,
    visibility = ["PUBLIC"],
)

