haskell_library(
    name = "tidepool_extract_internal",
    srcs = _EXTRACTOR_SRCS,
    _haskell_toolchain = "toolchains//:haskell_with_extractor_source_inputs",
    compiler_flags = extractor_library_flags("-XOverloadedStrings"),
    linker_flags = extractor_library_link_flags(),
    visibility = ["PUBLIC"],
)


# Debug information and local entry symbols retain the selected optimization
# profile. This worker is a distinct compiler producer; its scopes must be
# generated afresh rather than copied from a production worker.
haskell_library(
    name = "tidepool_extract_internal_profile",
    srcs = _EXTRACTOR_SRCS,
    _haskell_toolchain = "toolchains//:haskell_with_extractor_source_inputs",
    compiler_flags = extractor_library_flags("-XOverloadedStrings", "-g3", "-fexpose-internal-symbols", "-finfo-table-map"),
    linker_flags = extractor_library_link_flags(),
)

haskell_binary(
    name = "tidepool_extract_bin_profile",
    link_style = "static_pic",
    srcs = {"Main.hs": "app/Main.hs"},
    deps = [":tidepool_extract_internal_profile"],
    compiler_flags = extractor_binary_flags("-XOverloadedStrings", "-g3", "-fexpose-internal-symbols", "-finfo-table-map"),
    linker_flags = ["-dynamic"] + extractor_library_link_flags() + ["-with-rtsopts=-T"],
    visibility = ["PUBLIC"],
)

haskell_library(
    name = "assignment_internal",
    srcs = {"Tidepool/Agent/Assignment/Internal.hs": "lib/Tidepool/Agent/Assignment/Internal.hs"},
    compiler_flags = assignment_component_flags("-XOverloadedStrings"),
    visibility = ["PUBLIC"],
)

haskell_binary(
    name = "tidepool_extract_bin",
    # Retain project code in the executable copied at run startup; installed
    # packages remain dynamically linked from the immutable Nix closure.
    link_style = "static_pic",
    srcs = {"Main.hs": "app/Main.hs"},
    deps = [":tidepool_extract_internal"],
    compiler_flags = extractor_binary_flags("-XOverloadedStrings"),
    linker_flags = ["-dynamic"] + extractor_library_link_flags() + ["-with-rtsopts=-T"],
    visibility = ["PUBLIC"],
)

