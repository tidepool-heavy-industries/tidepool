-- The only default-built executable. `app/Main.hs`'s own import closure pulls
-- in no lib/Tidepool/** module (the eval stdlib is a runtime GHC include
-- path, not a host-compiled dependency — see bridge/haskell/CLAUDE.md), so
-- hs-source-dirs is just `app` and everything else comes from the internal
-- library.
executable tidepool-extract-bin
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    base >= 4.20 && < 5,
    ghc  >= 9.12 && < 9.13,
    tidepool-extract-internal,
    bytestring,
    cborg,
    containers,
    cryptohash-sha256,
    filepath,
    directory,
    text
  default-language: GHC2024
  default-extensions: OverloadedStrings
  -- Collect RTS statistics by default. Trusted process owners may configure
  -- RTS startup options; the daemon disables idle GC for its resident worker.
  -- Typed compiler requests do not carry RTS command-line arguments.
  ghc-options:      -Wall -Werror=missing-fields -threaded -rtsopts -with-rtsopts=-T

