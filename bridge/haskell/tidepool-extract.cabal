    Tidepool.ExecutionProjection
    Tidepool.ExecutionEncode
    Tidepool.Json
    Tidepool.Resolve
    Tidepool.Session
    Tidepool.SessionArtifacts
    Tidepool.Timing
    Tidepool.TypePolicy
    Tidepool.TurnSource
  build-depends:
    base         >= 4.20 && < 5,
    ghc          >= 9.12 && < 9.13,
    ghc-boot     >= 9.12 && < 9.13,
    bytestring,
    containers,
    deepseq,
    filepath,
    directory,
    process,
    template-haskell,
    time,
    text,
    cborg,
    cryptohash-sha256,
    unix,
    mtl,
    syb,
    lens,
    errors,
    witherable,
    safe
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall

-- Exposes only the model-facing name-error vocabulary ('renderNameError' and
-- friends) to host-side tests, without adding the rest of 'lib/Tidepool' (the
-- eval stdlib, a runtime GHC include path — see the note above
-- 'tidepool-extract-bin') as a host hs-source-dir, which would collide on
-- module names ('Tidepool.Introspection' exists both here and under 'src/')
-- with 'tidepool-extract-internal' proper.
library assignment-internal
  hs-source-dirs:   lib
  exposed-modules:  Tidepool.Agent.Assignment.Internal
  build-depends:
    base >= 4.20 && < 5,
    text
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall

