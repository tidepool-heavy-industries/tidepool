[cells]
root = .
prelude = prelude
toolchains = toolchains
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
buck = none

# The pinned Buck2 executable carries its matching Prelude.
[external_cells]
prelude = bundled

[parser]
target_platform_detector_spec = target:root//...->root//platforms:platforms \
  target:toolchains//...->root//platforms:platforms

[build]
execution_platforms = root//platforms:platforms

# Fast incremental work remains the default. Select `production` explicitly
# for matched optimized host and GHC worker builds; `debug` disables native
# optimization while retaining compiler diagnostics.
[tidepool]
profile = fast-dev

# Keep source-control metadata outside Buck input discovery.
[project]
ignore = .git
