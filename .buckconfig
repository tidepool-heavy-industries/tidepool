[cells]
root = .
prelude = prelude
toolchains = toolchains
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
buck = none

# The pinned Buck2 executable carries its matching Prelude.
[external_cells]
prelude = bundled

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default \
  target:toolchains//...->prelude//platforms:default

[build]
execution_platforms = root//platforms:platforms
