.tidepool/*
.shoal/logs/
.shoal/sessions/
.shoal/runtime/
.shoal/build/
.exomonad/logs/
.exomonad/sessions/
.exomonad/runtime/
.exomonad/build/
# A workspace's generated state, wherever the workspace lives. The
# anchored patterns above only match a workspace at the repository root,
# so an example workspace's nix-store symlinks were stageable by accident.
**/.shoal/logs/
**/.shoal/sessions/
**/.shoal/runtime/
**/.shoal/build/
**/.exomonad/logs/
**/.exomonad/sessions/
**/.exomonad/runtime/
**/.exomonad/build/
# API keys dropbox — must NEVER be allowlisted back in
.tidepool/secrets/
!.tidepool/lib/
!.tidepool/PATTERNS.md
target/
/target-*/
dist-newstyle/
dist-newstyle-*/
bridge/haskell/dist-fixtures-final/
# scripts/bench-turn.sh results (timestamped, machine-specific — not committed)
bench/
*.hi
*.o
*.dyn_hi
*.dyn_o
.exo/
.gemini/
result

# Temp investigation/research files
*.md.tmp
*.tmp.md
investigate-*.tmp.md

# Scratch files
*.txt
*.csv
scratch*

# Binary artifacts
bridge/haskell/tidepool-extract
bridge/haskell/haskell/
bridge/haskell/test/text_cbor/
*.proptest-regressions

# Debug artifacts
*.cbor
!bridge/haskell/test-execution-schema-encode/fixtures/schema6-intrinsic.cbor
!bridge/haskell/test-prepared-stg/fixtures/freer-retention.cbor
!bridge/haskell/test-prepared-stg/fixtures/freer-resume.cbor
!bridge/haskell/test-prepared-stg/fixtures/import-producer.cbor
!bridge/haskell/test-prepared-stg/fixtures/import-consumer.cbor
!bridge/haskell/test-prepared-stg/fixtures/import-consumer-result.cbor
*.log
dump_*.rs
test_*.hs

# Ad-hoc test artifacts
bridge/haskell/Test*.hs
bridge/haskell/TestB_cbor/
bridge/haskell/test-*.hs
bridge/haskell/test-*_cbor/
bridge/haskell/test/InlineTest*.hs
bridge/haskell/test/InlineTest*_cbor/
bridge/haskell/test/LocalEqString.hs
bridge/haskell/test/LocalEqString_cbor/
test_*_cbor/
bridge/haskell/lib/Tidepool/Prelude_cbor/

# Leaked internal bindings from --all-closed extraction
bridge/haskell/test/suite_cbor/$*.cbor
bridge/haskell/test/suite_cbor/mymap*.cbor
bridge/haskell/test/suite_cbor/myappend.cbor
bridge/haskell/test/suite_cbor/myconcat.cbor
bridge/haskell/test/suite_cbor/myfilter.cbor
bridge/haskell/test/suite_cbor/r.cbor
bridge/haskell/test/suite_cbor/r_*.cbor
bridge/haskell/test/suite_cbor/con_nested_just_1.cbor
bridge/haskell/test/suite_cbor/*.asks.json

# Duplicate extraction output (Suite_cbor/ vs suite_cbor/)
bridge/haskell/test/Suite_cbor/

# Experimental Haskell modules (none currently)
bridge/haskell/test-prelude.hs

# Generated viz output
viz/index.html
# Preserve stale pre-Exomonad local runtime data if it reappears.
.exo/
.claude/

# cabal-generated GHC environment files (written by cabal v2 in-place builds)
.ghc.environment.*

# per-worktree MCP config (holds a worktree-specific --papers path; never commit)
.mcp.json

# extract test harness scratch (synthetic fixture modules + their .hi/.o)
bridge/haskell/test-session/work/
bridge/haskell/test-fidelity/work/
bridge/haskell/spike-batch/work-*/
bridge/haskell/spike-build-products/work/

# Per-worktree XDG cache used by isolated checks and local tools.
.cache/
.cache-bisect*/
# Python test/import caches
__pycache__/
*.pyc
